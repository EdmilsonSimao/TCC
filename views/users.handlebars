<section class="max-w-7xl mx-auto px-4 py-12">

  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row justify-between items-center mb-10 gap-4">
    <div>
      <h1 class="text-3xl font-bold">Utilizadores</h1>
      <p class="text-base-content/50 text-sm mt-1">Gerencie todos os utilizadores do sistema</p>
    </div>
    <div class="flex gap-2">
      <span class="badge badge-soft badge-primary text-sm px-4 py-3">
        <span class="icon-[tabler--users] size-4 mr-1"></span>
        {{usuarios.length}} utilizadores
      </span>
    </div>
  </div>

  <!-- FILTROS + PESQUISA -->
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">

    <!-- Filtros por género -->
    <div class="flex flex-wrap gap-2" id="filtros">
      <button class="btn btn-sm btn-primary filtro-btn" data-filtro="todos">Todos</button>
      <button class="btn btn-sm btn-outline filtro-btn" data-filtro="M">
        <span class="icon-[tabler--gender-male] size-4"></span> Masculino
      </button>
      <button class="btn btn-sm btn-outline filtro-btn" data-filtro="F">
        <span class="icon-[tabler--gender-female] size-4"></span> Feminino
      </button>
    </div>

    <!-- Pesquisa -->
    <div class="input max-w-xs w-full">
      <span class="icon-[tabler--search] text-base-content/60 my-auto me-3 size-5 shrink-0"></span>
      <input type="search" id="input-pesquisa" class="grow" placeholder="Pesquisar por nome, email ou país..." />
    </div>

  </div>

  <!-- CONTADOR -->
  <p class="text-sm text-base-content/50 mb-4">
    A mostrar <span id="contador" class="font-semibold text-base-content">{{usuarios.length}}</span> utilizadores
  </p>

  {{#if usuarios.length}}

  <!-- TABELA -->
  <div class="bg-base-100 rounded-2xl shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-pin-rows w-full">
        <thead class="bg-base-200">
          <tr>
            <th>Utilizador</th>
            <th>Contacto</th>
            <th>País</th>
            <th>Género</th>
            <th>Nascimento</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody id="tabela-body">
          {{#each usuarios}}
          <tr class="linha-usuario hover:bg-base-200 transition-colors"
              data-genero="{{genero}}"
              data-nome="{{nome}}"
              data-email="{{email}}"
              data-pais="{{pais}}">

            <!-- Avatar + Nome + Email -->
            <td>
              <div class="flex items-center gap-3">
                <div class="avatar placeholder">
                  <div class="rounded-full w-10 text-sm font-bold
                    {{#ifEquals genero 'Masculino'}}bg-blue-100 text-blue-700
                    {{else}}bg-pink-100 text-pink-700{{/ifEquals}}">
                    <span>{{iniciais}}</span>
                  </div>
                </div>
                <div>
                  <p class="font-semibold text-sm">{{nome}}</p>
                  <p class="text-xs text-base-content/50">{{email}}</p>
                </div>
              </div>
            </td>

            <!-- Telefone -->
            <td>
              <div class="flex items-center gap-1 text-sm text-base-content/70">
                <span class="icon-[tabler--phone] size-4"></span>
                {{telefone}}
              </div>
            </td>

            <!-- País -->
            <td>
              <div class="flex items-center gap-1 text-sm">
                <span class="icon-[tabler--map-pin] size-4 text-base-content/40"></span>
                {{pais}}
              </div>
            </td>

            <!-- Género -->
            <td>
              {{#ifEquals genero "M"}}
                <span class="badge badge-soft badge-info badge-sm">
                  <span class="icon-[tabler--gender-male] size-3 mr-1"></span> Masculino
                </span>
              {{else ifEquals genero "F"}}
                <span class="badge badge-soft badge-error badge-sm">
                  <span class="icon-[tabler--gender-female] size-3 mr-1"></span> Feminino
                </span>
              {{else}}
                <span class="badge badge-soft badge-ghost badge-sm">{{genero}}</span>
              {{/ifEquals}}
            </td>

            <!-- Data Nascimento -->
            <td class="text-sm text-base-content/60">
              <div class="flex items-center gap-1">
                <span class="icon-[tabler--cake] size-4"></span>
                {{data}}
              </div>
            </td>

            <!-- Ações -->
            <td>
              <div class="flex justify-center gap-1">
                <a href="/perfil" class="btn btn-circle btn-text btn-sm" aria-label="Ver detalhes">
                  <span class="icon-[tabler--eye] size-5"></span>
                </a>
                <a href="/users/{{id}}" class="btn btn-circle btn-text btn-sm" aria-label="Editar">
                  <span class="icon-[tabler--pencil] size-5"></span>
                </a>
                <a href="/deleteusers/{{id}}" class="btn btn-circle btn-text btn-sm text-error" aria-label="Eliminar">
                  <span class="icon-[tabler--trash] size-5"></span>
                </a>
              </div>
            </td>

          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    
    <!-- VAZIO PÓS FILTRO -->
    <div id="sem-resultados" class="hidden text-center py-16">
      <span class="icon-[tabler--user-off] size-14 text-base-content/20 mx-auto block"></span>
      <p class="text-base-content/50 mt-4">Nenhum utilizador encontrado.</p>
      <button class="btn btn-outline btn-sm mt-4 filtro-btn" data-filtro="todos">Ver todos</button>
    </div>

  </div>

  {{else}}

  <!-- VAZIO TOTAL -->
  <div class="text-center py-24">
    <span class="icon-[tabler--users-off] size-20 text-base-content/20 mx-auto block"></span>
    <h2 class="text-xl font-semibold mt-6">Nenhum utilizador registado</h2>
    <p class="text-base-content/50 mt-2 text-sm">Os utilizadores registados aparecerão aqui.</p>
  </div>

  {{/if}}

</section>


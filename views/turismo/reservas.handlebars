<section class="p-6">
  <h1 class="text-center my-10 text-2xl font-bold">Todas as Reservas</h1>

  <div class="border-base-content/25 w-full rounded-lg border mx-auto p-4">

    <!-- HEADER: FILTRO + PESQUISA + CONTADOR -->
    <div class="flex flex-wrap justify-between items-center gap-4 p-4">

      <!-- Filtro -->
      <div class="flex items-center gap-3">
        <p class="text-sm text-base-content/60">Filtrar por:</p>
        <div class="dropdown relative inline-flex">
          <button id="dropdown-filtro" type="button"
            class="dropdown-toggle btn btn-outline btn-secondary font-normal"
            aria-haspopup="menu" aria-expanded="false">
            <span class="icon-[tabler--filter] size-4"></span>
            <span id="filtro-label">Todas</span>
            <span class="icon-[tabler--chevron-down] dropdown-open:rotate-180 size-4"></span>
          </button>
          <ul class="dropdown-menu dropdown-open:opacity-100 hidden min-w-36" role="menu">
            <li><a class="dropdown-item" href="#" data-filtro="todas">
              <span class="icon-[tabler--list] size-4 mr-1"></span> Todas
            </a></li>
            <li><a class="dropdown-item" href="#" data-filtro="Confirmada">
              <span class="icon-[tabler--circle-check] size-4 mr-1 text-success"></span> Confirmadas
            </a></li>
            <li><a class="dropdown-item" href="#" data-filtro="pendente">
              <span class="icon-[tabler--clock] size-4 mr-1 text-info"></span> Pendentes
            </a></li>
            <li><a class="dropdown-item" href="#" data-filtro="Cancelada">
              <span class="icon-[tabler--circle-x] size-4 mr-1 text-warning"></span> Canceladas
            </a></li>
            <li><a class="dropdown-item" href="#" data-filtro="Concluída">
              <span class="icon-[tabler--flag] size-4 mr-1 text-primary"></span> Concluídas
            </a></li>
          </ul>
        </div>

        <!-- Badge contador -->
        <span id="contador-badge" class="badge badge-soft badge-primary text-xs">
          <span id="contador-num">0</span> reservas
        </span>
      </div>

      <!-- Pesquisa -->
      <div class="input max-w-xs">
        <span class="icon-[tabler--search] text-base-content/80 my-auto me-3 size-5 shrink-0"></span>
        <input type="search" id="input-pesquisa" class="grow" placeholder="Pesquisar cliente ou destino..." />
      </div>

    </div>

    <!-- TABELA -->
    <div class="h-[500px] overflow-x-auto">
      <table class="table-pin-rows table w-full">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Destino</th>
            <th>Pessoas</th>
            <th>Status</th>
            <th>Check-in</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody id="tabela-body">
          {{#each reservas}}
          <tr class="linha-reserva hover:bg-base-200 transition-colors"
              data-status="{{status}}"
              data-cliente="{{cliente}}"
              data-destino="{{destino}}">
            <td class="font-medium">{{cliente}}</td>
            <td class="text-base-content/70">{{destino}}</td>
            <td>{{n_pessoas}}</td>
            <td>
              {{#ifEquals status "Confirmada"}}
                <span class="badge badge-soft badge-success text-xs">Confirmada</span>
              {{else ifEquals status "pendente"}}
                <span class="badge badge-soft badge-info text-xs">Pendente</span>
              {{else ifEquals status "Cancelada"}}
                <span class="badge badge-soft badge-warning text-xs">Cancelada</span>
              {{else ifEquals status "Concluída"}}
                <span class="badge badge-soft badge-primary text-xs">Concluída</span>
              {{/ifEquals}}
            </td>
            <td class="text-sm text-base-content/60">{{data_checkin}}</td>
            <td>
              <a href="/updateReserva/{{id}}">
                <button class="btn btn-circle btn-text btn-sm" aria-label="Editar">
                  <span class="icon-[tabler--pencil] size-5"></span>
                </button>
              </a>
              <a href="/deleteReserva/{{id}}">
                <button class="btn btn-circle btn-text btn-sm text-error" aria-label="Eliminar">
                  <span class="icon-[tabler--trash] size-5"></span>
                </button>
              </a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <!-- Estado vazio -->
      <div id="sem-resultados" class="hidden flex flex-col items-center justify-center py-20 text-base-content/40">
        <span class="icon-[tabler--database-off] size-12 mb-3"></span>
        <p class="text-sm">Nenhuma reserva encontrada</p>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="flex justify-between items-center px-4 pt-4 border-t border-base-content/10 text-xs text-base-content/50">
      <span>A mostrar <span id="footer-count">0</span> resultados</span>
      <button id="btn-limpar" class="btn btn-xs btn-ghost hidden">
        <span class="icon-[tabler--x] size-3"></span> Limpar filtros
      </button>
    </div>

  </div>
</section>


  
{{#each error_msg}}
<div class="alert alert-error shadow-lg max-w-5xl mx-auto mb-4 mt-4">
  <span class="icon-[tabler--alert-circle] size-5"></span>
  <span>{{texto}}</span>
</div>
{{/each}}

{{#each success_msg}}
<div class="alert alert-success shadow-lg max-w-5xl mx-auto mb-4 mt-4">
  <span class="icon-[tabler--check-circle] size-5"></span>
  <span>{{texto}}</span>
</div>
{{/each}}


        <div class="flex justify-between items-center mb-2">
          <h3 class="text-xl font-bold">Reservar visita</h3>
          <span class="text-success font-bold text-sm">
            25.000 AKZ
            <span class="text-base-content/40 font-normal text-xs">/pessoa</span>

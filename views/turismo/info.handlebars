</section>

<!-- CTA FINAL -->
<section class="py-20 bg-slate-900 text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-3xl mx-auto text-center px-6 relative">
    <span class="badge badge-primary mb-4">Não perca esta oportunidade</span>

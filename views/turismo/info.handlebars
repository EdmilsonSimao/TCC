      <span class="icon-[tabler--calendar-plus] size-5"></span>
      Fazer reserva
    </button>
  </div>
</section>

<!-- MODAL PAGAMENTO -->
<div id="paymentModal"
  class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50 p-4">

  <div class="bg-base-100 w-full max-w-lg rounded-2xl shadow-2xl relative overflow-hidden max-h-[85vh] flex flex-col">

    <!-- TOPO FIXO -->
    <div class="bg-gradient-to-r from-primary to-primary/80 p-6 text-white flex-shrink-0">
      <button onclick="closePayment()"
        class="absolute top-4 right-4 btn btn-sm btn-circle bg-white/20 border-0 text-white hover:bg-white/30">✕</button>
      <h2 class="text-2xl font-bold flex items-center gap-2">
        <span class="icon-[tabler--credit-card] size-7"></span> Pagamento
      </h2>
      <p class="text-white/70 text-sm mt-1">Confirme os detalhes e efetue o pagamento</p>
    </div>

    <!-- CONTEÚDO COM SCROLL -->
    <div class="overflow-y-auto flex-1 p-6 space-y-5">

      <!-- RESUMO -->
      <div class="bg-base-200 rounded-xl p-4 space-y-2 text-sm">
        <h3 class="font-semibold text-base mb-3">Resumo da reserva</h3>
        <div class="flex justify-between">
          <span class="text-base-content/60">Destino</span>
          <strong>{{lugares.nome}}</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Pessoas</span>
          <strong id="qtdPessoas">—</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Check-in</span>
          <strong id="dataEntrada">—</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Check-out</span>
          <strong id="dataSaida">—</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/60">Preço por pessoa</span>
          <strong>25.000 AKZ</strong>
        </div>
        <div class="divider my-1"></div>
        <div class="flex justify-between text-lg font-bold">
          <span>Total</span>
          <span id="totalValor" class="text-success">25.000 AKZ</span>
        </div>
      </div>

      <!-- MÉTODOS DE PAGAMENTO -->
      <div>
        <h3 class="font-semibold mb-3 text-sm">Método de pagamento</h3>
        <div class="space-y-2">
          <div class="flex items-center justify-between bg-slate-800 rounded-xl px-4 py-3">
            <div>
              <p class="text-slate-400 text-xs mb-0.5">IBAN</p>
              <p class="text-white font-mono text-sm">AO0000600.12345670.1001</p>
            </div>
            <button type="button"
              onclick="copiar('AO0000600.12345670.1001', this)"
              class="btn btn-xs btn-ghost text-slate-400 hover:text-white">
              <span class="icon-[tabler--copy] size-4"></span>
            </button>
          </div>
          <div class="flex items-center justify-between bg-slate-800 rounded-xl px-4 py-3">
            <div>
              <p class="text-slate-400 text-xs mb-0.5">Multicaixa Express</p>
              <p class="text-white font-mono text-sm">929 778 512</p>
            </div>
            <button type="button"
              onclick="copiar('929778512', this)"
              class="btn btn-xs btn-ghost text-slate-400 hover:text-white">
              <span class="icon-[tabler--copy] size-4"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- COMPROVATIVO -->
      <form action="/reserva" method="post" enctype="multipart/form-data">
        <input type="hidden" name="check_in"  id="hiddenCheckIn">
        <input type="hidden" name="check_out" id="hiddenCheckOut">
        <input type="hidden" name="pessoas"   id="hiddenPessoas">
        <input type="hidden" name="id"        value="{{lugares.id}}">

        <div class="space-y-2">
          <label class="text-sm font-medium block">Comprovativo de pagamento</label>
          <label for="file"
            class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-base-content/20 rounded-xl p-6 cursor-pointer hover:border-primary hover:bg-primary/5 transition-all">
            <span class="icon-[tabler--upload] size-8 text-primary"></span>
            <span class="text-sm text-base-content/60 text-center">
              Clique para enviar o comprovativo
            </span>
            <span class="text-xs text-base-content/40">JPG, PNG ou PDF · Máx. 5MB</span>
          </label>
          <input id="file" name="comprovativo" type="file" class="hidden" accept="image/*,.pdf" />
          <div id="file-preview" class="hidden items-center gap-2 bg-success/10 border border-success/30 rounded-xl px-4 py-2">
            <span class="icon-[tabler--file-check] size-5 text-success"></span>
            <p id="file-nome" class="text-xs text-success font-medium truncate flex-1"></p>
            <button type="button" onclick="removerFicheiro()"
              class="text-base-content/40 hover:text-error">
              <span class="icon-[tabler--x] size-4"></span>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-success w-full mt-5">
          <span class="icon-[tabler--check] size-5"></span>
          Confirmar pagamento
        </button>
      </form>

    </div>
    <!-- FIM SCROLL -->

  </div>
</div>

<script>
  const PRECO_POR_PESSOA = 25000;

  const inputPessoas  = document.getElementById('nPessoas');
  const inputCheckin  = document.getElementById('check_in');
  const inputCheckout = document.getElementById('check_out');

  function formatarData(val) {
    if (!val) return '—';
    const [y, m, d] = val.split('-');
    return `${d}/${m}/${y}`;
  }

  function formatarValor(n) {
    return n.toLocaleString('pt-AO') + ' AKZ';
  }

  function atualizarPreview() {
    const pessoas = parseInt(inputPessoas.value) || 1;
    const total   = pessoas * PRECO_POR_PESSOA;
    document.getElementById('preview-pessoas').textContent = pessoas;
    document.getElementById('preview-total').textContent   = formatarValor(total);
  }

  inputPessoas.addEventListener('input', atualizarPreview);
  atualizarPreview();

  function openPagamento() {
    const pessoas  = parseInt(inputPessoas.value) || 1;
    const checkin  = inputCheckin.value;
    const checkout = inputCheckout.value;

    if (!checkin || !checkout) {
      alert('Por favor selecione as datas de check-in e check-out.');
      return;
    }
    if (checkin >= checkout) {
      alert('A data de check-out deve ser posterior ao check-in.');
      return;
    }

    document.getElementById('qtdPessoas').textContent  = pessoas;
    document.getElementById('dataEntrada').textContent = formatarData(checkin);
    document.getElementById('dataSaida').textContent   = formatarData(checkout);
    document.getElementById('totalValor').textContent  = formatarValor(pessoas * PRECO_POR_PESSOA);

    document.getElementById('hiddenCheckIn').value  = checkin;
    document.getElementById('hiddenCheckOut').value = checkout;
    document.getElementById('hiddenPessoas').value  = pessoas;

    const modal = document.getElementById('paymentModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closePayment() {
    const modal = document.getElementById('paymentModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Fechar ao clicar fora
  document.getElementById('paymentModal').addEventListener('click', function(e) {
    if (e.target === this) closePayment();
  });

  // Datas mínimas
  const hoje = new Date().toISOString().split('T')[0];
  inputCheckin.min  = hoje;
  inputCheckout.min = hoje;
  inputCheckin.addEventListener('change', () => {
    inputCheckout.min = inputCheckin.value;
    if (inputCheckout.value && inputCheckout.value <= inputCheckin.value) {
      inputCheckout.value = '';
    }
  });

  // Ficheiro comprovativo
  document.getElementById('file').addEventListener('change', function() {
    const file    = this.files[0];
    const preview = document.getElementById('file-preview');
    const nome    = document.getElementById('file-nome');
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        alert('O ficheiro não pode ter mais de 5MB.');
        this.value = '';
        return;
      }
      nome.textContent = file.name;
      preview.classList.remove('hidden');
      preview.classList.add('flex');
    }
  });

  function removerFicheiro() {
    document.getElementById('file').value = '';
    const preview = document.getElementById('file-preview');
    preview.classList.add('hidden');
    preview.classList.remove('flex');
  }

  // Copiar para clipboard com feedback
  function copiar(texto, btn) {
    navigator.clipboard.writeText(texto).then(() => {
      const original = btn.innerHTML;
      btn.innerHTML = '<span class="icon-[tabler--check] size-4 text-success"></span>';
      setTimeout(() => { btn.innerHTML = original; }, 1500);
    });
  }
</script>
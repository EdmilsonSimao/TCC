<section class="minhaReserva max-w-7xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold mb-8 text-center">Minhas Reservas</h1>

  {{#if reservas.length}}

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {{#each reservas}}
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body space-y-3">

        <!-- Destino -->
        <h2 class="card-title text-xl">
          <span class="icon-[tabler--map-pin] size-5"></span>
          {{destino}}
        </h2>

        <!-- Datas -->
        <div class="text-sm space-y-1">
          <p>
            <span class="icon-[tabler--calendar] size-4"></span>
            <strong>Check-in:</strong> {{data_checkin}}
          </p>
          <p>
            <span class="icon-[tabler--calendar] size-4"></span>
            <strong>Check-out:</strong> {{data_checkout}}
          </p>
        </div>

        <!-- Pessoas -->
        <p class="text-sm">
          <span class="icon-[tabler--users] size-4"></span>
          <strong>Pessoas:</strong> {{n_pessoas}}
        </p>

        <!-- Status -->
        <div class="flex items-center justify-between">
          {{#ifEquals status "Confirmada"}}
            <span class="badge badge-success">{{status}}</span>

          {{else ifEquals status "Cancelada"}}
            <span class="badge badge-error">{{status}}</span>

          {{else ifEquals status "pendente"}}
            <span class="badge badge-warning">{{status}}</span>

          {{else}}
            <span class="badge badge-info">{{status}}</span>
          {{/ifEquals}}

          <a href="/updateReserva/{{id}}" class="btn btn-sm btn-outline">
            Detalhes
          </a>
        </div>

      </div>
    </div>
    {{/each}}
  </div>

  {{else}}

  <div class="text-center py-20">
    <span class="icon-[tabler--calendar-off] size-16 text-gray-400"></span>
    <p class="text-lg mt-4">Você ainda não possui reservas.</p>
    <a href="/destinos" class="btn btn-primary mt-6">Explorar Destinos</a>
  </div>

  {{/if}}
</section>

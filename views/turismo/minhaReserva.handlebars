
<section class="max-w-7xl mx-auto px-4 py-12">

  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row justify-between items-center mb-10 gap-4">
    <div>
      <h1 class="text-3xl font-bold">Minhas Reservas</h1>
      <p class="text-base-content/50 text-sm mt-1">Gerencie todas as suas viagens</p>
    </div>
    <a href="/destinos" class="btn btn-primary btn-sm">
      <span class="icon-[tabler--plus] size-4"></span>
      Nova Reserva
    </a>
  </div>

  {{#if reservas.length}}

  <!-- FILTROS RÁPIDOS -->
  <div class="flex flex-wrap gap-2 mb-8" id="filtros">
    <button class="btn btn-sm btn-primary filtro-btn" data-filtro="todas">Todas</button>
    <button class="btn btn-sm btn-outline filtro-btn" data-filtro="Confirmada">
      <span class="size-2 rounded-full bg-success inline-block"></span> Confirmadas
    </button>
    <button class="btn btn-sm btn-outline filtro-btn" data-filtro="pendente">
      <span class="size-2 rounded-full bg-warning inline-block"></span> Pendentes
    </button>
    <button class="btn btn-sm btn-outline filtro-btn" data-filtro="Cancelada">
      <span class="size-2 rounded-full bg-error inline-block"></span> Canceladas
    </button>
    <button class="btn btn-sm btn-outline filtro-btn" data-filtro="Concluída">
      <span class="size-2 rounded-full bg-info inline-block"></span> Concluídas
    </button>
  </div>

  <!-- CONTADOR -->
  <p class="text-sm text-base-content/50 mb-4">
    A mostrar <span id="contador" class="font-semibold text-base-content">{{reservas.length}}</span> reservas
  </p>

  <!-- CARDS -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="grid-reservas">
    {{#each reservas}}
    <div class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow duration-300 card-reserva"
         data-status="{{status}}">

      <!-- Topo colorido por status -->
      <div class="h-2 rounded-t-2xl
        {{#ifEquals status 'Confirmada'}}bg-success
        {{else ifEquals status 'Cancelada'}}bg-error
        {{else ifEquals status 'pendente'}}bg-warning
        {{else}}bg-info{{/ifEquals}}">
      </div>

      <div class="card-body space-y-4">

        <!-- Destino + Status -->
        <div class="flex justify-between items-start">
          <h2 class="card-title text-lg leading-tight">
            <span class="icon-[tabler--map-pin] size-5 text-primary shrink-0"></span>
            {{destino}}
          </h2>
          {{#ifEquals status "Confirmada"}}
            <span class="badge badge-success badge-soft shrink-0">Confirmada</span>
          {{else ifEquals status "Cancelada"}}
            <span class="badge badge-error badge-soft shrink-0">Cancelada</span>
          {{else ifEquals status "pendente"}}
            <span class="badge badge-warning badge-soft shrink-0">Pendente</span>
          {{else}}
            <span class="badge badge-info badge-soft shrink-0">{{status}}</span>
          {{/ifEquals}}
        </div>

        <!-- Datas -->
        <div class="bg-base-200 rounded-xl p-3 space-y-2 text-sm">
          <div class="flex justify-between items-center">
            <span class="flex items-center gap-1 text-base-content/60">
              <span class="icon-[tabler--calendar-event] size-4"></span> Check-in
            </span>
            <span class="font-semibold">{{data_checkin}}</span>
          </div>
          <div class="divider my-0 py-0 h-px"></div>
          <div class="flex justify-between items-center">
            <span class="flex items-center gap-1 text-base-content/60">
              <span class="icon-[tabler--calendar-check] size-4"></span> Check-out
            </span>
            <span class="font-semibold">{{data_checkout}}</span>
          </div>
        </div>

        <!-- Pessoas -->
        <div class="flex items-center gap-2 text-sm text-base-content/70">
          <span class="icon-[tabler--users] size-4"></span>
          <span><strong>{{n_pessoas}}</strong> pessoa(s)</span>
        </div>

        <!-- Ações -->
        <div class="card-actions justify-end pt-2 border-t border-base-content/10">
          <a href="/updateReserva/{{id}}" class="btn btn-sm btn-outline flex-1">
            <span class="icon-[tabler--eye] size-4"></span>
            Detalhes
          </a>
          {{#ifEquals status "pendente"}}
          <a href="/cancelarReserva/{{id}}" class="btn btn-sm btn-error btn-outline">
            <span class="icon-[tabler--x] size-4"></span>
            Cancelar
          </a>
          {{/ifEquals}}
        </div>

      </div>
    </div>
    {{/each}}
  </div>

  <!-- VAZIO APÓS FILTRO -->

  <div id="sem-resultados" class="hidden text-center py-16">
    <span class="icon-[tabler--filter-off] size-14 text-base-content/30 mx-auto block"></span>
    <p class="text-lg mt-4 text-base-content/50">Nenhuma reserva com este estado.</p>
    <button class="btn btn-outline btn-sm mt-4 filtro-btn" data-filtro="todas">Ver todas</button>
  </div>

  {{else}}
  <!-- ESTADO VAZIO TOTAL -->
  <div class="text-center py-24">
    <span class="icon-[tabler--calendar-off] size-20 text-base-content/20 mx-auto block"></span>
    <h2 class="text-xl font-semibold mt-6">Ainda não tem reservas</h2>
    <p class="text-base-content/50 mt-2 text-sm">Explore os nossos destinos e faça a sua primeira reserva.</p>
    <a href="/destinos" class="btn btn-primary mt-8">
      <span class="icon-[tabler--compass] size-4"></span>
      Explorar Destinos
    </a>
  </div>

  {{/if}}

</section>


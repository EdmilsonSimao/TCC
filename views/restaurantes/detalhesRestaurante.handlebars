<section class="bg-base-200">

  <!-- HERO -->
  <div class="relative h-[350px] w-full">
    <img
      src="{{restaurante.imagem.image1}}"
      alt="{{restaurante.nome}}"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60 flex items-center">
      <div class="container mx-auto px-6 text-white">
        <h1 class="text-4xl md:text-5xl font-bold">{{restaurante.nome}}</h1>
        <p class="mt-3 text-lg max-w-2xl">
          {{restaurante.descricao}}
        </p>
        <div class="flex gap-2 mt-4">
          <span class="badge badge-success">{{restaurante.tipo}}</span>
          <span class="badge badge-outline text-white">
            {{restaurante.cidade}} · {{restaurante.provincia}}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTEÚDO -->
  <div class="container mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-10">

    <!-- ESQUERDA -->
    <div class="space-y-10">
 
      <!-- GALERIA -->
      <div>
        <h2 class="text-2xl font-semibold mb-4">Galeria</h2>
        <div class="grid grid-cols-2 md:grid-cols-2 gap-4">
          <img src="{{restaurante.imagem.image1}}" class="rounded-xl object-cover h-40 w-full" />
        </div>
      </div>

      <!-- PRATOS -->
      <div>
        <h2 class="text-2xl font-semibold mb-4">Pratos em destaque</h2>
        <div class="grid md:grid-cols-3 gap-6">

          {{#each restaurante.imagem}}
          <div class="card bg-white shadow-md">
            <figure>
              <img src="{{this}}" class="h-40 w-full object-cover" />
            </figure>

            <div class="card-body">
              <h3 class="card-title">{{[restaurante.pratos]}}</h3>
              <p class="text-sm text-gray-600">descricao</p>
              <div class="flex justify-between items-center mt-2">
                <span class="font-bold text-primary">
                  {{restaurante.preco}} Kz 30kz
                </span>
               <a href="/reservasMesa/1 "> <button class="btn btn-sm btn-outline btn-primary">
                  Reservar
                </button></a>
              </div>
            </div>
          </div>
          {{/each}}

        </div>
      </div>

      <!-- AVALIAÇÕES -->
      <div>
        <h2 class="text-2xl font-semibold mb-4">Avaliações dos clientes</h2>

        <div class="space-y-4">
          {{#each restaurante.avaliacoes}}
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="flex items-center gap-3">
                <div class="avatar">
                  <div class="w-10 rounded-full">
                    <img src="{{avatar}}" />
                  </div>
                </div>
                <div>
                  <p class="font-semibold">clente nome</p>
                  <div class="flex gap-1">
                    {{#times estrelas}}
                      <span class="icon-[tabler--star-filled] text-warning size-5"></span>
                    {{/times}}
                        <span class="icon-[tabler--star-filled] text-warning size-5"></span>
                  </div>
                </div>
              </div>
              <p class="text-sm mt-2 text-gray-600">
               comentário do cliente sobre o restaurante
              </p>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

    </div>

    <!-- DIREITA -->
    <aside class="space-y-6">

      <!-- INFO -->
      <div class="card bg-white shadow-lg">
        <div class="card-body space-y-3">
          <h3 class="text-xl font-semibold">Informações</h3>

          <p>
            <span class="font-medium">Endereço:</span><br>
            {{restaurante.localizacao}}
          </p>

          <p>
            <span class="font-medium">Telefone:</span><br>
            924567870
          </p>

          <p>
            <span class="font-medium">Horário:</span><br>
            12h:30
          </p>

          <a href="/reservasMesa/{{restaurante.id}}" class="btn btn-primary w-full mt-4">
            Reservar Mesa
          </a>
        </div>
      </div>

    </aside>

  </div>

</section>
<!-- MAPA -->
      <div class="bg-white rounded-3xl shadow-xl p-8">
        <h2 class="text-3xl font-bold mb-4">Localização</h2>

        <iframe
          class="w-full h-80 rounded-2xl"
          src="{{restaurante.url_map}}"
          loading="lazy"
        ></iframe>
      </div>

<section class="bg-base-200 min-h-screen py-12">
  <div class="container mx-auto px-6 max-w-4xl">

    <div class="card bg-white shadow-xl">
      <div class="card-body">

        <h2 class="text-3xl font-bold text-center mb-6">
          Reserva de Mesa
        </h2>

        <form action="/reservas/restaurante/{{id}}" method="POST" class="space-y-5">

          <!-- Restaurante -->
          <div>
            <label class="label font-semibold">Restaurante</label>
            <input
              type="text"
              class="input input-bordered w-full"
              value="{{restaurante.nome}}"
              disabled
            />
          </div>

          <!-- Data -->
          <div>
            <label class="label font-semibold">Data da Reserva</label>
            <input
              type="date"
              name="data_reserva"
              class="input input-bordered w-full"
              required
            />
          </div>

          <!-- Hora -->
          <div>
            <label class="label font-semibold">Hora</label>
            <input
              type="time"
              name="hora_reserva"
              class="input input-bordered w-full"
              required
            />
          </div>

          <!-- Pessoas -->
          <div>
            <label class="label font-semibold">Número de Pessoas</label>
            <select name="n_pessoas" class="select select-bordered w-full">
              <option value="1">1 Pessoa</option>
              <option value="2">2 Pessoas</option>
              <option value="3">3 Pessoas</option>
              <option value="4">4 Pessoas</option>
              <option value="5">5+</option>
            </select>
          </div>

          <!-- Observações -->
          <div>
            <label class="label font-semibold">Observações</label>
            <textarea
              name="observacoes"
              class="textarea textarea-bordered w-full"
              placeholder="Ex: mesa ao ar livre, comemoração..."
            ></textarea>
          </div>

          <!-- Botão -->
          <button type="submit" class="btn btn-primary w-full">
            Confirmar Reserva
          </button>

        </form>

      </div>
    </div>

  </div>
</section>

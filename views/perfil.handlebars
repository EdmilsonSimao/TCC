<!-- HERO PERFIL -->
<section class="bg-gradient-to-br from-slate-800 via-slate-900 to-slate-800 py-20 relative overflow-hidden">
  <!-- Decoração de fundo -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-success rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative">
    <div class="flex flex-col md:flex-row items-center gap-8">

      <!-- Avatar -->
      <div class="avatar">
        <div class="w-28 rounded-full ring-4 ring-primary ring-offset-4 ring-offset-slate-900 shadow-xl">
          <img src="/img/user.png" alt="{{user.nome}}" />
        </div>
      </div>

      <!-- Info -->
      <div class="text-white text-center md:text-left flex-1">
        <div class="flex flex-col md:flex-row md:items-center gap-3">
          <h1 class="text-4xl font-bold">{{user.nome}}</h1>
          <span class="badge badge-success badge-sm self-center">Ativo</span>
        </div>
        <p class="text-slate-300 mt-2 flex items-center justify-center md:justify-start gap-2">
          <span class="icon-[tabler--mail] size-4"></span>
          {{user.email}}
        </p>
        <p class="text-slate-400 text-sm mt-1 flex items-center justify-center md:justify-start gap-2">
          <span class="icon-[tabler--calendar] size-4"></span>
          Membro desde • 2025
        </p>
      </div>

      <!-- Stats rápidas -->
      <div class="flex gap-6 text-center">
        <div class="bg-white/10 backdrop-blur rounded-2xl px-6 py-4">
          <p class="text-2xl font-bold text-white">{{reservas.length}}</p>
          <p class="text-slate-400 text-xs mt-1">Reservas</p>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-2xl px-6 py-4">
          <p class="text-2xl font-bold text-white">{{avaliacoes.length}}</p>
          <p class="text-slate-400 text-xs mt-1">Avaliações</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CONTEÚDO -->
<section class="py-14 bg-base-200 min-h-screen">
  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-4 gap-8">

    <!-- SIDEBAR -->
    <aside class="lg:col-span-1 space-y-3 h-fit">

      <!-- Card perfil -->
      <div class="bg-white/10 rounded-2xl shadow-md p-5">
        <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wider mb-3 px-2">Menu</p>

        <a href="/user/minhaReserva"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-primary/10 hover:text-primary transition-colors group">
          <span class="icon-[tabler--calendar-check] size-5 text-base-content/40 group-hover:text-primary"></span>
          <span class="text-sm font-medium">Minhas Reservas</span>
        </a>

        <a href="/minhaAvaliacao"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-primary/10 hover:text-primary transition-colors group">
          <span class="icon-[tabler--star] size-5 text-base-content/40 group-hover:text-primary"></span>
          <span class="text-sm font-medium">Avaliações</span>
        </a>

        <a href="/pagamentos"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-primary/10 hover:text-primary transition-colors group">
          <span class="icon-[tabler--credit-card] size-5 text-base-content/40 group-hover:text-primary"></span>
          <span class="text-sm font-medium">Pagamentos</span>
        </a>

        <a href="/configuracoes"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-primary/10 hover:text-primary transition-colors group">
          <span class="icon-[tabler--settings] size-5 text-base-content/40 group-hover:text-primary"></span>
          <span class="text-sm font-medium">Configurações</span>
        </a>

        <div class="border-t border-base-content/10 mt-3 pt-3">
          <a href="/logout"
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-error/10 hover:text-error transition-colors group">
            <span class="icon-[tabler--logout] size-5 text-base-content/40 group-hover:text-error"></span>
            <span class="text-sm font-medium">Sair</span>
          </a>
        </div>
      </div>

      <!-- Card info pessoal -->
      <div class="bg-base-100 rounded-2xl shadow-md p-5 space-y-3">
        <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wider">Informações</p>
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2 text-base-content/70">
            <span class="icon-[tabler--phone] size-4"></span>
            <span>{{user.telefone}}</span>
          </div>
          <div class="flex items-center gap-2 text-base-content/70">
            <span class="icon-[tabler--map-pin] size-4"></span>
            <span>{{user.pais}}</span>
          </div>
          <div class="flex items-center gap-2 text-base-content/70">
            <span class="icon-[tabler--cake] size-4"></span>
            <span>{{user.data_nascimento}}</span>
          </div>
        </div>
        <a href="/users/{{user.id}}" class="btn btn-outline btn-sm w-full mt-2">
          <span class="icon-[tabler--pencil] size-4"></span>
          Editar perfil
        </a>
      </div>

    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="lg:col-span-3 space-y-8">

      <!-- RESERVAS -->
      <div class="bg-base-100 rounded-2xl shadow-md p-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2">
            <span class="icon-[tabler--calendar-check] size-6 text-primary"></span>
            Minhas Reservas
          </h2>
          <a href="/user/minhaReserva" class="text-xs text-primary hover:underline">Ver todas →</a>
        </div>

        {{#if reservas.length}}
        <div class="space-y-3">
          {{#each reservas}}
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 p-4 rounded-xl border border-base-content/10 hover:border-primary/30 hover:bg-primary/5 transition-all">

            <!-- Lado esquerdo -->
            <div class="flex items-center gap-4">
              <div class="bg-primary/10 rounded-xl p-3">
                <span class="icon-[tabler--map-pin] size-6 text-primary"></span>
              </div>
              <div>
                <h3 class="font-semibold text-sm">{{destino}}</h3>
                <div class="flex flex-wrap gap-3 mt-1 text-xs text-base-content/50">
                  <span class="flex items-center gap-1">
                    <span class="icon-[tabler--calendar] size-3"></span> {{data_checkin}}
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="icon-[tabler--users] size-3"></span> {{n_pessoas}} pessoa(s)
                  </span>
                </div>
              </div>
            </div>

            <!-- Lado direito -->
            <div class="flex items-center gap-3 shrink-0">
              {{#ifEquals status "Confirmada"}}
                <span class="badge badge-success badge-soft badge-sm">Confirmada</span>
              {{else ifEquals status "Cancelada"}}
                <span class="badge badge-error badge-soft badge-sm">Cancelada</span>
              {{else ifEquals status "pendente"}}
                <span class="badge badge-warning badge-soft badge-sm">Pendente</span>
              {{else}}
                <span class="badge badge-info badge-soft badge-sm">{{status}}</span>
              {{/ifEquals}}
              <a href="/updateReserva/{{id}}" class="btn btn-sm btn-outline">
                <span class="icon-[tabler--eye] size-4"></span> Ver
              </a>
            </div>

          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="text-center py-12">
          <span class="icon-[tabler--calendar-off] size-14 text-base-content/20 mx-auto block"></span>
          <p class="text-base-content/40 text-sm mt-3">Ainda não tem reservas.</p>
          <a href="/destinos" class="btn btn-primary btn-sm mt-4">Explorar Destinos</a>
        </div>
        {{/if}}
      </div>

      <!-- AVALIAÇÕES -->
      <div class="bg-base-100 rounded-2xl shadow-md p-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2">
            <span class="icon-[tabler--star] size-6 text-amber-400"></span>
            Minhas Avaliações
          </h2>
          <a href="/minhaAvaliacao" class="text-xs text-primary hover:underline">Ver todas →</a>
        </div>

        {{#if avaliacoes.length}}
        <div class="grid sm:grid-cols-2 gap-4">
          {{#each avaliacoes}}
          <div class="p-4 rounded-xl border border-base-content/10 hover:shadow-md transition-shadow space-y-3">
            <div class="flex justify-between items-start">
              <h3 class="font-semibold text-sm">{{destino}}</h3>
              <div class="flex gap-0.5">
                {{#times estrelas}}
                  <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                {{/times}}
                {{#times estrelasVazias}}
                  <span class="icon-[tabler--star] size-4 text-base-content/20"></span>
                {{/times}}
              </div>
            </div>
            <p class="text-sm text-base-content/60">{{comentario}}</p>
            <p class="text-xs text-base-content/30">{{data}}</p>
          </div>
          {{/each}}
        </div>
        {{else}}
        <!-- Avaliações estáticas de exemplo se não vier do servidor -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-xl border border-base-content/10 space-y-3">
            <div class="flex justify-between items-start">
              <h3 class="font-semibold text-sm">Serra da Leba</h3>
              <div class="flex gap-0.5">
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
              </div>
            </div>
            <p class="text-sm text-base-content/60">Lugar incrível, experiência inesquecível.</p>
          </div>
          <div class="p-4 rounded-xl border border-base-content/10 space-y-3">
            <div class="flex justify-between items-start">
              <h3 class="font-semibold text-sm">Ilha do Mussulo</h3>
              <div class="flex gap-0.5">
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star-filled] size-4 text-amber-400"></span>
                <span class="icon-[tabler--star] size-4 text-base-content/20"></span>
              </div>
            </div>
            <p class="text-sm text-base-content/60">Ótimo atendimento e paisagem maravilhosa.</p>
          </div>
        </div>
        {{/if}}
      </div>

    </main>
  </div>
</section>
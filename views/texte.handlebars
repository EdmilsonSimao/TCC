<!-- EDITAR PERFIL -->
<section class="max-w-3xl mx-auto bg-white rounded-2xl shadow-md p-8 my-6">

  <h2 class="text-3xl font-bold mb-8 text-dark flex items-center gap-3">
    <i class="fas fa-user-edit"></i>
    Editar Perfil
  </h2>

  <form action="/usuario/atualizar" method="POST" class="space-y-6">

    <!-- FOTO -->
    <div class="flex flex-col items-center gap-4">
      <img src="{{usuario.foto}}" 
           class="w-32 h-32 rounded-full object-cover border-4 border-b-gray-500-400 shadow-lg">

      <input type="file" name="foto"
        class="text-sm text-gray-300
               file:mr-4 file:py-2 file:px-4
               file:rounded-lg file:border-0
               file:text-sm file:font-semibold
               file:bg-blue-600 file:text-black
               hover:file:bg-blue-700">
    </div>

    <!-- NOME -->
    <div>
      <label class="block mb-2  text-black">Nome</label>
      <input type="text" name="nome" value="{{usuario.nome}}"
        class="w-full p-3 rounded-lg focus:outline-none border border-b-gray-700 ">
    </div>

    <!-- EMAIL -->
    <div>
      <label class="block mb-2 text-black">Email</label>
      <input type="email" name="email" value="{{usuario.email}}"
        class="w-full p-3 rounded-lg  focus:outline-none  border border-b-gray-700">
    </div>

    <!-- TELEFONE -->
    <div>
      <label class="block mb-2  text-black">Telefone</label>
      <input type="text" name="telefone" value="{{usuario.telefone}}"
        class="w-full p-3 rounded-lg focus:outline-none  border border-b-gray-700">
    </div>

    <!-- SENHA -->
    <div>
      <label class="block mb-2 text-black">Nova Senha</label>
      <input type="password" name="senha"
        placeholder="Digite uma nova senha"
        class="w-full p-3 rounded-lg focus:outline-none  border border-b-gray-700" >
    </div>

    <!-- BOTÃO -->
    <div class="text-center">
      <button type="submit"
        class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition duration-300 shadow-lg">
        <i class="fas fa-save mr-2"></i>
        Salvar Alterações
      </button>
    </div>

  </form>
</section>